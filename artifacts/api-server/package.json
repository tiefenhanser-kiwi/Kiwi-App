{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file=.env --import tsx --test src/lib/__tests__/*.test.ts src/lib/ai/__tests__/*.test.ts src/routes/__tests__/*.test.ts",
    "prisma:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "prisma:seed:dev": "node --env-file=.env --import tsx prisma/seeds/devData.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@prisma/client": "^6.19.3",
    "@workspace/api-zod": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "express": "^5",
    "jimp": "^1.6.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9",
    "pino-http": "^10",
    "recipe-ingredient-parser-v3": "^1.5.0",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cheerio": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "prisma": "^6.19.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
