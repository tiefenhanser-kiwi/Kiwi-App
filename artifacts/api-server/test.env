# LIFE-1 -- loaded by `pnpm test` AFTER .env (`--env-file=.env --env-file=test.env`;
# with Node's --env-file the later file wins). It exists for one reason: the dev
# .env turns real sending ON (LIFECYCLE_EMAIL_ENABLED=true) and carries a real
# RESEND_API_KEY, and the suite loads .env -- so without this override every
# route test that signs someone up would hand a real welcome email to Resend.
# Tests that need sending on pass their own env object; none read this file.
LIFECYCLE_EMAIL_ENABLED=false
FEEDBACK_TO=
