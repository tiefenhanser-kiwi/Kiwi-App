// kiwi/server/prisma/schema.prisma
// Complete database schema matching the D2 data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──

enum AccountStatus {
  active
  paused
  deleted
  blocked
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  none
}

enum SubscriptionPlan {
  free
  premium_monthly
  premium_annual
}

enum MealType {
  breakfast
  lunch
  dinner
  snack
  mixed
}

enum SourceType {
  wizard
  directed
  imported_url
  uploaded_image
  manual
  curated
  // D-WS9-036 (Plan-Gen Arc Block 2) — pre-generated meal store provenance.
  // Provenance is orthogonal to isPublic (pool membership) and userId
  // (ownership): a store Meal is a Meal row that is in the shared pool
  // (isPublic:true) AND carries one of these stamps for HOW it was made.
  //   batch_generated — minted by the offline store-fill batch job.
  //   live_writeback  — a live gap-fill generation stamped + published back
  //                     into the store so a future compose can reuse it.
  //   community       — headroom for launch user-sharing (users publishing
  //                     their own meals to the community kitchen). No code
  //                     emits this yet; added now so a later ship needs no
  //                     enum migration.
  batch_generated
  live_writeback
  community
}

enum DifficultyLevel {
  easy
  medium
  fancy
}

enum WeeklyPacing {
  mostly_easy
  mixed
  one_fancy_night
  minimal_effort
}

enum PlanStatus {
  this_week
  next_week
  upcoming
  past
  draft
}

enum PrepStatus {
  not_prepped
  partial
  prepped
}

enum GroceryListStatus {
  draft
  active
  // WS7-7-A Block 2 — §12.6.3 mark-shopping-done. Bidirectional active⇄completed.
  // Distinct from `ordered` (reserved for the future retailer order flow).
  completed
  ordered
  archived
}

enum IntegrationType {
  api
  rpa
  hybrid
  affiliate
}

enum StepPhase {
  prep
  cook
  rest
  preheat
  assemble
  hold
}

enum DishRole {
  main
  side
  sauce
  topping
  base
  optional
}

enum StoreSection {
  produce
  meat_seafood
  dairy_eggs
  bakery_bread
  pantry
  canned
  frozen
  snacks
  household
  extras
}

enum RestockCadence {
  always_stocked
  weekly
  monthly
  remind_when_low
}

enum ActivityEventType {
  login
  view_plan
  cook_meal
  generate_grocery
  order_groceries
  wizard_start
  wizard_complete
  wizard_failure
  plan_created
  plan_deleted
  upgrade_started
  upgrade_completed
  trial_started
  trial_expired
  meal_found_similar_used
  dish_macros_estimated
  plan_macros_recalculated
  recipe_imported_url
  recipe_imported_image
  recipe_imported_text
  grocery_item_added
  plan_review_opened
  plan_meal_assigned
  plan_meal_unassigned
  plan_meal_changed
  plan_recipe_changed
  plan_meal_edited
  plan_meal_composted
  plan_meal_added
  plan_breakfast_customized
  plan_lunch_customized
  plan_grocery_generated
  plan_prep_started
  plan_name_edited
  plan_used_from_browse
  plan_preview_opened
  plan_composted
  plan_date_range_edited
  plan_status_changed
  plan_activated_this_week
  wizard_candidate_expanded
}

enum SpiceTolerance {
  mild
  medium
  hot
  very_hot
}

enum BudgetLevel {
  economy
  mid_range
  premium
}

enum AIPromptMode {
  tool
  text
}

// ── MODELS ──

model User {
  id                       String             @id @default(uuid())
  email                    String             @unique
  passwordHash             String?
  firstName                String
  lastName                 String
  phone                    String?
  zipCode                  String?
  timezone                 String             @default("America/New_York")
  accountStatus            AccountStatus      @default(active)
  subscriptionStatus       SubscriptionStatus @default(trialing)
  defaultHouseholdSize     Int                @default(2)
  customerStartDate        DateTime           @default(now())
  customerEndDate          DateTime?
  lastLoginAt              DateTime?
  lastActiveAt             DateTime?
  loginCountTotal          Int                @default(0)
  lastPlanDiscoveryFilters String[]           @default([])
  lastPlansFilters         String[]           @default([])
  lastMealsFilters         String[]           @default([])
  marketingConsentEmail    Boolean            @default(false)
  marketingConsentSms      Boolean            @default(false)
  // WS7-2 Block A: routing flags consumed by mobile post-login navigation.
  // onboardingComplete gates /onboarding-prefs vs /(tabs).
  // firstRunChoiceMade gates /first-run-destination after onboarding.
  // Backfilled true for existing rows in the migration (they're dev-test
  // accounts already in use; should not be re-onboarded).
  onboardingComplete       Boolean            @default(false)
  firstRunChoiceMade       Boolean            @default(false)
  // WS9 3a / D-WS9-026 — set ONCE on the user's first committed plan
  // (write-if-null guard; NEVER overwritten — it is a *first*, not a
  // *latest*). A timestamp, not a boolean: `IS NULL` gives the home
  // teaching-arc collapse gate, and the value doubles as the time-to-first-
  // plan activation metric (un-reconstructable after the fact). Nullable,
  // no backfill — the DB is wiped before launch; the first create flips it.
  firstPlanCreatedAt       DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  // Relations
  preferences             UserPreferences?
  wizardLastBatch         WizardLastBatch?
  pantryStaples           PantryStaple[]
  planTemplates           MealPlanTemplate[]
  planInstances           MealPlanInstance[]
  meals                   Meal[]
  dishes                  Dish[]
  favorites               Favorite[]
  groceryLists            GroceryList[]
  retailerConnections     RetailerConnection[]
  orderSessions           OrderSession[]
  subscription            Subscription?
  activities              UserActivity[]
  aiPromptVersionsCreated AIPromptVersion[]    @relation("PromptVersionCreator")
  systemSettingsUpdated   SystemSetting[]      @relation("SettingUpdater")
  llmCalls                LLMCallLog[]         @relation("LLMCallUser")

  @@map("users")
}

// WS7-2 Block A — per-user meal favorites. Cascade-deleted on user or meal
// removal. Server is the source of truth (mobile AsyncStorage cache discarded
// on first launch post-Block-B, per Phase 1 locked decision 7).
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  mealId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([userId, mealId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model UserPreferences {
  id                      String          @id @default(uuid())
  userId                  String          @unique
  householdSize           Int             @default(2)
  wantsLeftovers          Boolean         @default(false)
  difficultyDefault       DifficultyLevel @default(easy)
  weeklyPacingDefault     WeeklyPacing    @default(mostly_easy)
  // Renamed from dietaryRestrictions in WS7-2 Block A (mobile contract).
  allergiesAndAvoidances  String[]        @default([])
  // Renamed from cuisinePreferences in WS7-2 Block A.
  cuisines                String[]        @default([])
  breakfastDefaults       String?
  lunchDefaults           String?
  macroPref               String[]        @default([])
  notificationsEnabled    Boolean         @default(true)
  lastUsedRetailerId      String?
  // Hidden-context fields surfaced into the wizard AI input (PRD §5.7).
  // Server-injected only; not user-editable from the wizard form.
  // Renamed from equipment in WS7-2 Block A.
  cookingEquipment        String[]        @default([])
  spiceTolerance          SpiceTolerance  @default(mild)
  budgetLevel             BudgetLevel     @default(mid_range)
  pickyAvoidances         String[]        @default([])
  // Renamed from recurringItems in WS7-2 Block A.
  recurringGroceryItems   String[]        @default([])
  // WS7-2 Block A — widened to mobile UserPreferencesData contract.
  // Nullable opt-in fields stay null until the user touches them in the
  // preferences screen; mobile Block B widens its types to allow null.
  eatingStyles            String[]        @default([])
  cookingSkill            String?
  stovetopType            String?
  kidsCount               Int             @default(0)
  pickyEaterCount         Int             @default(0)
  healthGoals             String[]        @default([])
  planLengthDefault       Int             @default(7)
  defaultRetailer         String?
  dietaryNotes            String?
  // Cookbook Phase B — new preference fields (Block 1: storage + wire only;
  // generation wiring is Block 2, mobile UI is Block 3). String-with-default
  // for the categorical prefs matches the newer cookingSkill/stovetopType
  // convention (Zod validates the value set, not the DB).
  discoveryMealsPerWeek   Int             @default(0)
  saucePreference         String          @default("balanced")
  maxCookTimeMinutes      Int?
  maxCookTimeCoverage     String          @default("most")
  // WS9 3d (D-WS9-013) — stamped in PATCH /me/preferences ONLY when an
  // allergy/dietary field changes (allergiesAndAvoidances / dietaryNotes /
  // eatingStyles / pickyAvoidances). Distinct from the generic `updatedAt`
  // below, which @updatedAt bumps on EVERY column write (household size,
  // retailer, …) and so over-fires for the staleness note. The Plan Review
  // dietary-staleness note (§8.3) and grocery-list echo (§12.4) compare this
  // against the plan/list commit timestamp. Nullable, no backfill: null =
  // "no dietary edit recorded" → the note stays silent (safe default).
  dietaryUpdatedAt        DateTime?
  updatedAt               DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Plan-Gen Arc Block 4b-3 (D-WS9-072) — the user's LAST generated plan-options
// batch: the pre-expand candidate cards from the most recent build-plans /
// build-from-text / surprise-me run, so "See Previous Options" can re-show the
// last run without regenerating. EXACTLY ONE row per user (userId @unique): each
// successful generation UPSERTS this row, and that overwrite IS "generation
// clears" — nothing else clears it, not even activation (Hans's ruling: after
// "Use this plan" the batch still shows, including the option the user used).
// `payload` is { source, candidates, input } where `input` is the request slice
// needed to rebuild candidateContext at a later expand (null for surprise —
// context re-derives from stored prefs). It is a SNAPSHOT by design: no
// preference-hash invalidation or allergen re-check at rehydrate (D-WS9-085
// ruling). Deliberately holds NO foreign key into the plan graph so the table
// stays cleanly droppable; cascade-deleted with the user.
model WizardLastBatch {
  id        String   @id @default(uuid())
  userId    String   @unique
  payload   Json
  source    String
  // The generation time of THIS batch. An upsert-overwrite is a NEW batch, so
  // the write path bumps this to now(); a display surface (WS9 3c) can read it.
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wizard_last_batches")
}

model PantryStaple {
  id             String         @id @default(uuid())
  userId         String
  ingredientName String
  restockCadence RestockCadence @default(always_stocked)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ingredientName])
  @@map("pantry_staples")
}

// WS9 D-WS9-189 Block A1 — the three ingredient relationships.
//
// Hans sorted the catalog's fragmentation into three kinds without naming them,
// and the whole failure of today's approach is that ONE mechanism serves all
// three by inferring intent from names: STAPLE_VARIANT_TO_BASE correctly folds
// `extra virgin olive oil` -> `olive oil` (synonym) while wrongly folding
// `flaky sea salt` -> `salt` (distinct) — in the same map, indistinguishable to
// the code. Naming the relationship makes each future instance a DATA ROW
// rather than a bug.
//
//   synonym   same purchase, different names ("granulated" / "white" sugar)
//   component different ingredients, ONE thing you buy (lime -> lime juice;
//             pepperoncini -> its brine, out of one jar)
//   distinct  different products sharing a word (iodized salt is NOT kosher is
//             NOT flaky sea salt; peppercorns are not ground black pepper)
//   subsumes  D-WS9-202 — a GENERIC name covers a SPECIFIC one. `bell peppers`
//             subsumes `red bell pepper`: a shopper who needs "bell peppers"
//             is satisfied by red ones, but not the reverse.
enum IngredientRelationLabel {
  synonym
  component
  distinct
  subsumes
}

// Judge confidence. DELIBERATELY AN ENUM, NOT A FLOAT: a model asked for 0..1
// emits false precision (0.87 vs 0.85 carries no information), and the only
// decision this field drives is binary — auto-accept, or surface to Hans.
// Three buckets is the whole resolution that decision needs.
enum IngredientRelationConfidence {
  high
  medium
  low
}

// Who authored the row. `human` is never overwritten by `ai_judge` — see
// reviewedByHuman on IngredientRelation.
enum IngredientRelationSource {
  ai_judge
  human
  seed
}

model Ingredient {
  id                  String   @id @default(uuid())
  canonicalName       String   @unique
  displayName         String
  category            String
  subcategory         String?
  defaultUnit         String
  nutritionRefPerUnit Json?
  // WS9 BUG-096 (D-WS9-174) — SUPERSEDED by the IngredientAlias table below.
  // Retained (not dropped) so the 6c-6 seeded values survive the cutover, but
  // NOTHING reads or writes it any more: the alias source of truth is
  // `ingredient_aliases`, which carries the unique index that makes a colliding
  // alias a P2002 instead of a silent coin-flip. Drop candidate: D-WS7-218.
  aliases             String[] @default([])
  isOptionalDefault   Boolean  @default(false)
  // WS6 6c-4: purchase-pack metadata for grocery list consolidation.
  // Filled by Block B (AI reconciliation); null until then.
  purchaseUnit        String?
  purchaseQuantity    Float?
  purchaseDisplay     String?
  // WS7-8b B2 (D-WS7-197): shared unit-conversion + purchase-size payload.
  // Shape mirrors IngredientConversion (ingredientConversions.ts): optional
  // gramsPerCup / gramsPerEach / subUnit / purchase* + a `source` provenance
  // stamp ('curated' | 'usda_derived' | 'ai_estimated'). Seeded + backfilled
  // from the code table + USDA foodPortions; runtime AI-fallback fills gaps
  // stamped 'ai_estimated'. Null until seeded/backfilled.
  conversionRef       Json?

  dishIngredients DishIngredient[]
  groceryItems    GroceryListItem[]
  aliasRows       IngredientAlias[]
  // WS9 D-WS9-189 A1 — ROW->ROW relationships. Deliberately separate from
  // aliasRows above, which is STRING->ROW; the two are never consulted
  // together (D-WS9-193).
  relationsFrom   IngredientRelation[] @relation("IngredientRelationFrom")
  relationsTo     IngredientRelation[] @relation("IngredientRelationTo")

  @@map("ingredients")
}

// WS9 BUG-096 (D-WS9-174) — alias source of truth, replacing the inert
// `Ingredient.aliases String[]`.
//
// WHY A TABLE AND NOT THE ARRAY: Ruling 2 requires a colliding alias to RAISE,
// not to be silently resolved one way or the other. Postgres cannot enforce
// that on a `text[]` — an exclusion constraint needs an index AM with
// `amgettuple` (GiST/SP-GiST only; GIN has none), and core Postgres ships no
// GiST opclass for `text[]`. A unique index on a scalar column is the only
// mechanism that actually enforces it, and it needs its own row to sit on.
//
// `aliasKey` is `normalizeAliasKey(alias)` (lower + collapse whitespace + trim,
// ingredientLookup.ts) and carries the @unique. `alias` keeps the authored
// casing for display. Two rows claiming one alias is now a P2002 at write time
// rather than a coin flip at read time.
//
// PRECEDENCE (ruled): a canonical name ALWAYS beats an alias. So an aliasKey
// that also exists as some row's canonicalName is legal and deliberate — 16
// such pairs exist today: alias "salt" is owned by row "kosher salt" while a
// separate row "salt" also exists, and alias "egg" is owned by "large eggs"
// beside a row "egg". This table enforces only "no alias string owned by two
// rows", which is the invariant the resolver's determinism actually rests on.
//
// ⚠️ Both numbers here were wrong until BUG-135 measured them: the count read
// 20, and the worked example read alias "apple" on row "apples" — a pair that
// does not exist in the catalog at all ("apples" was folded away by BUG-096).
//
// Cascade on ingredient delete so a merged-away loser cannot leave a dangling
// alias behind; the merge moves the loser's aliases onto the survivor first.
model IngredientAlias {
  id           String @id @default(uuid())
  ingredientId String
  // Authored form, casing preserved (display + provenance).
  alias        String
  // normalizeAliasKey(alias). THE uniqueness surface.
  aliasKey     String @unique

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_aliases")
}

// WS9 D-WS9-189 Block A1 — the ingredient-relationship substrate.
//
// D-WS9-193 — THIS TABLE AND `ingredient_aliases` NEVER CONSULT EACH OTHER.
// They answer different questions at different stages:
//   IngredientAlias    maps a STRING -> a ROW, at name resolution
//                      (ingredientLookup.ts:119 / :159, ingredientSearch.ts:58 / :73)
//   IngredientRelation maps a ROW    -> a ROW, at consolidation
// A synonym verdict writes HERE and only here; it never mints an alias row.
//
// 🔴 D-WS9-201 — THE READER TAKES DIRECT EDGES ONLY. NO TRANSITIVE CLOSURE.
// EVER. Two rows fold only if a stored relation says THOSE TWO are synonym.
//
// WHY, measured: under closure the A1 pilot's largest synonym class reached 23
// rows and swept `lard` and `avocado oil` into the neutral-oil blob; a second
// chained `crushed tomatoes` to `whole peeled tomatoes`. ⚠️ NO SINGLE VERDICT
// HAS TO BE WRONG FOR THIS — `lard ~ shortening ~ neutral oil ~ avocado oil` is
// a chain of individually defensible edges whose closure is indefensible. A
// human reviews edges; nobody reviews the chain. And it is safety-adjacent, not
// cosmetic: that closure misrepresents a vegetarian, kosher or halal user's
// list.
//
// ⚠️ THE CONTRADICTION DETECTOR DOES CLOSE TRANSITIVELY, AND THAT ASYMMETRY IS
// DELIBERATE — see scripts/ws9-d189-a1/contradiction.ts. A guard may reason
// more aggressively than a consumer acts: closure there FINDS the over-merge,
// closure here WOULD SHIP it. A future pass will read the two as inconsistent
// and "fix" it by making the reader transitive. That is the regression.
//
// D-WS9-195 (context — Block B builds it, not A1): pooling runs as its own pass
// inside consolidatePlanIngredients, between the recurring match-or-append and
// mergeConvertibleGroups — never as a branch inside mergeGroup, whose contract
// is conservation and which pooling deliberately violates. This table is shaped
// so that pass can read it without further joins.
//
// WHY `distinct` IS STORED RATHER THAN OMITTED: an absent row and a
// judged-different row are indistinguishable, so every future pass would
// re-judge the same pairs forever and re-pay for them. A recorded "these are
// deliberately different" is what makes the decision durable — and it is the
// row Hans's ruling ("iodized salt is NOT kosher is NOT flaky sea salt") lives
// in.
model IngredientRelation {
  id               String @id @default(uuid())
  fromIngredientId String
  toIngredientId   String

  label IngredientRelationLabel

  // DIRECTIONALITY, and it differs by label. The table has ALWAYS been directed
  // — `from`/`to` with a unique on the ORDERED pair — so `subsumes` needed no
  // migration beyond the enum value.
  //   component — DIRECTED, and the direction is load-bearing: `from` is the
  //               thing you BUY (lime), `to` is the thing the recipe CALLS FOR
  //               (lime juice). Reversing it inverts the arithmetic.
  //   subsumes  — DIRECTED. `from` is the GENERIC, `to` is the SPECIFIC:
  //               `bell peppers` subsumes `red bell pepper`. Reversing it
  //               asserts that any bell pepper satisfies a demand for a red
  //               one, which is false, so the reverse row must never exist.
  //   synonym /  SYMMETRIC. Stored in canonical order (from.canonicalName <
  //   distinct    to.canonicalName, ordinal compare) so one pair is one row and
  //               `--apply` stays idempotent. Readers sort the pair the same
  //               way rather than querying both directions.

  // ── D-WS9-194: every component edge carries its magnitude ────────────────
  // A label alone says the edge EXISTS and nothing about the arithmetic, and
  // Block B cannot compute a pool from that. Neither field is derivable from
  // anything already stored: `conversionRef.gramsPerCup` relates volume to mass
  // and says nothing about how much of a lemon is juice.
  //
  // yieldQuantity / yieldUnit — how much `to` one unit of `from` yields:
  //   lemon -> lemon juice : 3, "tbsp"   (~2-3 tbsp of juice per lemon)
  //   lemon -> lemon zest  : 1, "tbsp"   (~1 tbsp of zest per lemon)
  // Required (non-null) on `component`; null on synonym / distinct.
  //
  // ⚠️ AND NULL ON `subsumes`, DELIBERATELY — DO NOT BACKFILL THEM. `subsumes`
  // is a SATISFIABILITY relation, not a yield relation: it says a demand for
  // the generic is met by the specific, and there is no quantity to carry.
  // "How much red bell pepper does one bell pepper yield" is not a question
  // with an answer — they are the same object under two names, one narrower.
  // A number here would be arithmetic Block B would then use.
  yieldQuantity Float?
  yieldUnit     String?

  // coHarvestable — CAN THIS DERIVATION SHARE A PHYSICAL UNIT WITH THE OTHER
  // co-harvestable derivations of the same `from`?
  //
  // ⚠️ LOAD-BEARING, and the reason the pool takes `max` per dimension rather
  // than `sum`. One lemon yields juice AND zest, so the need is
  // max(lemons_for_juice, lemons_for_zest) — not their sum. But juice and
  // WEDGES do not share: a wedge is the fruit, so those add.
  //
  // The per-edge encoding: true  = drawn from the shared pool, so it joins a
  //                                max() across the co-harvestable edges
  //                        false = consumes the unit exclusively, so it adds
  // Lime's pool is therefore max(juice, zest) + wedges. Without this field the
  // pool systematically over- or under-buys. Required on `component`, null
  // otherwise.
  coHarvestable Boolean?

  // ── provenance ───────────────────────────────────────────────────────────
  source     IngredientRelationSource
  confidence IngredientRelationConfidence
  // Judge model id + prompt version, so a verdict is attributable to the
  // instrument that produced it. D-WS9-197 exists because a verdict taken under
  // a defective rubric is not a verdict; a re-run under a fixed rubric has to
  // be able to find the rows the old one wrote.
  judgeModel    String?
  promptVersion String?
  // The judge's one-line reason. Kept because the CSV Hans reviews is only
  // legible with it, and because a wrong row stays diagnosable later.
  rationale String?
  // The batch this pair was judged in (D-WS9-197 half 1). Null for human/seed.
  familyKey String?
  // D-WS9-197 half 2 — the structural guard fired on this pair: analogous pairs
  // received divergent labels, or a synonym chain contradicts a distinct.
  contradictionFlag Boolean @default(false)

  // ⚠️ THE OVERWRITE GUARD. `--apply` upserts, and an upsert that clobbers a
  // human decision with an AI verdict silently destroys the only rows anyone
  // actually vetted. True => --apply skips the row entirely.
  reviewedByHuman Boolean   @default(false)
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from Ingredient @relation("IngredientRelationFrom", fields: [fromIngredientId], references: [id], onDelete: Cascade)
  to   Ingredient @relation("IngredientRelationTo", fields: [toIngredientId], references: [id], onDelete: Cascade)

  // One row per ordered pair. With canonical ordering on the symmetric labels
  // this makes a re-run a no-op rather than a duplicate.
  @@unique([fromIngredientId, toIngredientId])
  @@index([fromIngredientId])
  @@index([toIngredientId])
  @@index([label])
  @@map("ingredient_relations")
}

model Dish {
  id                   String          @id @default(uuid())
  userId               String?
  title                String
  description          String?
  // WS9 3f-4d (D-WS9-121) — short display name. null = render `title` as-is;
  // non-null = the ≤42-char name the UI shows while `title` STAYS canonical.
  // Mirrors MealPlanInstance.titleOverride. Resolved via resolveDisplayTitle.
  displayTitle         String?
  sourceType           SourceType      @default(manual)
  estimatedTimeMinutes Int             @default(30)
  difficulty           DifficultyLevel @default(easy)
  imageUrl             String?
  servingsDefault      Int             @default(4)
  // WS7-8 BUG-003 — immutable authored-servings anchor. Set once at create
  // (== servingsDefault) and NEVER updated on edit; render scales as
  // authoredQuantity × servingsDefault / authoredServingsDefault. Nullable:
  // legacy/seed rows are null and fall back to servingsDefault at render.
  authoredServingsDefault Int?
  tags                 String[]        @default([])
  caloriesPerServing   Float           @default(0)
  proteinGPerServing   Float           @default(0)
  carbsGPerServing     Float           @default(0)
  fatGPerServing       Float           @default(0)
  // D-WS9-050 Phase 2 — WRITE-TIME grounding stamp: the % of this dish's
  // counted (non-optional) ingredients that carried a USDA ref WHEN THE MACRO
  // ABOVE WAS WRITTEN (0..100). A write-time fact, NOT re-derived — if refs
  // improve later (P2 harvest / P3 curation) this stays as-written so we can
  // audit which catalog rows were computed blind. NULLABLE by design: null =
  // legacy/unknown provenance (pre-stamp rows, user-typed macros, or an
  // ungrounded generate_meal write awaiting recompute). Never backfilled with a
  // guess. Meal-level grounding is aggregated from these per-dish stamps.
  macroGroundedPct     Float?
  // Block 3.6 v3 (D-WS9-064) — store-bought substitutions: an OPTIONAL array of
  // convenience products, each replacing a GROUP of this dish's from-scratch
  // ingredients by name (shape: {product, quantity, unit, replaces: string[]}).
  // Authored by the store-fill generate call; the from-scratch ingredient list
  // stays complete and primary. NULLABLE — legacy rows and non-generated dishes
  // carry none. The grocery-list swap (later work) consumes this.
  substitutions        Json?
  // Block 3.7 (D-WS9-066) — swappable-component registry: the label/order
  // metadata for this dish's swappable components, keyed by `componentKey` (the
  // join key that ties tagged RecipeInstructionStep + DishIngredient rows and
  // the matching `substitutions` product together). Shape: an array of
  // { key: string, label: string, order: number }. Deliberately SEPARATE from
  // `substitutions` (which has a strict validated shape + a mutating sanitize
  // pass, and whose 1,125 existing rows we do not want to touch) — this is the
  // display/join metadata, substitutions is the shopping swap. NULLABLE — a dish
  // with no swappable components carries none. Authored by the store-fill
  // finalize call (Block 3.7 Phase 2).
  componentRegistry    Json?
  // Block 3.7 (D-WS7-215) — PER-USER component selection: a NON-DESTRUCTIVE map
  // { [componentKey]: 'scratch' | 'bought' } stored on the user's own (forked)
  // Dish. "Forever" is a stored selection, NEVER a rewrite of the step rows — a
  // user who buys coleslaw mix in December can still shred cabbage in July by
  // flipping it back. Absent key = the component's default (scratch). NULLABLE +
  // reversible. Per-plan selection (MealPlanItem.componentSelections) overrides
  // this. Nothing reads it yet (migration only).
  componentSelections  Json?
  timesCooked          Int             @default(0)
  lastUsedAt           DateTime?
  isArchived           Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user            User?            @relation(fields: [userId], references: [id])
  dishIngredients DishIngredient[]
  mealLinks       MealDishLink[]

  @@map("dishes")
}

model DishIngredient {
  id              String  @id @default(uuid())
  dishId          String
  ingredientId    String
  quantity        Float
  unit            String
  preparationNote String?
  isOptional      Boolean @default(false)
  positionIndex   Int     @default(0)
  // Block 3.7 (D-WS9-066) — swappable-component tags, mirroring
  // RecipeInstructionStep. Null `componentKey` = BASE ingredient (always in the
  // list). A tagged ingredient belongs to one component/path: the from-scratch
  // ingredients a product replaces are 'scratch'; the product itself is 'bought'.
  // The grocery-swap (out of scope here) will read these; nothing does yet.
  // NULLABLE — legacy rows are base, catalog stays valid untouched.
  componentKey    String?
  pathKey         String? // 'scratch' | 'bought' — enforced at application layer

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("dish_ingredients")
}

model Meal {
  id                   String          @id @default(uuid())
  userId               String?
  title                String
  description          String?
  // WS9 3f-4d (D-WS9-121) — short display name. null = render `title` as-is;
  // non-null = the ≤42-char name the UI shows while `title` STAYS the canonical
  // identity key (client dedupe, server dedupKey, wizard idempotency hash,
  // SwapMealSheet self-exclusion, AI ranking inputs). Mirrors
  // MealPlanInstance.titleOverride. Resolved via resolveDisplayTitle on read.
  displayTitle         String?
  mealType             MealType        @default(dinner)
  sourceType           SourceType      @default(manual)
  cuisineType          String?
  difficulty           DifficultyLevel @default(easy)
  estimatedTimeMinutes Int             @default(30)
  imageUrl             String?
  servingsDefault      Int             @default(4)
  // WS7-8 BUG-003 — immutable authored-servings anchor. Set once at create
  // (== servingsDefault) and NEVER updated on edit; render scales as
  // authoredQuantity × servingsDefault / authoredServingsDefault. Nullable:
  // legacy/seed rows are null and fall back to servingsDefault at render.
  authoredServingsDefault Int?
  tags                 String[]        @default([])
  // Plan-Gen Arc · Block 3 (D-WS9-042) — structured allergen data, distinct
  // from freeform `tags`. The store-fill harness derives these from a meal's
  // generated ingredients and STAMPS the array. A hard retrieval filter on
  // this column is deliberately DEFERRED — this is stamp-only for now.
  allergens            String[]        @default([])
  // Plan-Gen Arc · Block 3 (D-WS9-045) — the catalog "dish family" key: a slug
  // of the TARGET DISH a batch_generated meal was generated against (e.g.
  // "classic-cheeseburger"). Dedup keys on THIS, not the generated title
  // (accompaniments vary the title between runs → the 1C dedup defect). In
  // single-version mode there is one meal per key; multi-version (D-WS9-045)
  // will add N per key grouped as a dishFamily for plan mutual-exclusion.
  // Nullable — only batch_generated meals carry it.
  dishFamilyKey        String?
  caloriesPerServing   Float           @default(0)
  proteinGPerServing   Float           @default(0)
  carbsGPerServing     Float           @default(0)
  fatGPerServing       Float           @default(0)
  // Plan-Gen Arc · Block 4a (D-WS9-073, persist-only) — catalog lineage: the
  // store/pool Meal.id this copy was cloned from, written ONLY on the user-fork
  // branch of cloneMealInto (forkMealForUser). A publish-to-store / live_writeback
  // copy leaves this null — a write-back must not carry a self/foreign lineage.
  // Plain nullable id, NO FK: the lineage must survive even if the source store
  // meal is later archived/removed. Repeat-avoidance (feeding excludeMealIds,
  // D-WS9-073) CONSUMES this in Block 4b; nothing reads it yet (no index until the
  // consuming query shape is known).
  sourceStoreMealId    String?
  timesCooked          Int             @default(0)
  lastUsedAt           DateTime?
  isArchived           Boolean         @default(false)
  isPublic             Boolean         @default(false)
  likeCount            Int             @default(0)
  saveCount            Int             @default(0)
  useCount             Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user          User?                  @relation(fields: [userId], references: [id])
  dishLinks     MealDishLink[]
  planItems     MealPlanItem[]
  templateItems MealPlanTemplateItem[]
  favorites     Favorite[]

  // D-WS9-038 (Plan-Gen Arc Block 2) — store-shortlist retrieval index. The
  // compose read path filters the shared pool by (isPublic, isArchived,
  // mealType) and narrows/ranks by cuisineType; the leftmost prefix serves the
  // hard filter and the trailing cuisineType serves cuisine-scoped variants.
  // tags[] filtering (if ever added) needs a separate GIN index — not indexed
  // here since retrieval ranks on tags in-app rather than filtering on them.
  @@index([isPublic, isArchived, mealType, cuisineType])
  // D-WS9-045 — dedup + dishFamily lookup for the store-fill harness.
  @@index([sourceType, dishFamilyKey])
  @@map("meals")
}

model MealDishLink {
  id            String   @id @default(uuid())
  mealId        String
  dishId        String
  positionIndex Int      @default(0)
  roleLabel     DishRole @default(main)

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  dish Dish @relation(fields: [dishId], references: [id])

  @@unique([mealId, dishId])
  @@map("meal_dish_links")
}

model RecipeInstructionStep {
  id                 String    @id @default(uuid())
  ownerType          String // 'meal' | 'dish' — discriminator; enforced at application layer
  ownerId            String // FK enforced at application layer, not DB (Postgres cannot conditionally reference two tables)
  stepIndex          Int
  stepTextRaw        String
  stepTextTranslated String
  estimatedMinutes   Int       @default(1)
  phaseType          StepPhase @default(cook)
  parallelGroup      String?
  requiresPreheat    Boolean   @default(false)
  requiresRest       Boolean   @default(false)
  requiresMarination Boolean   @default(false)
  isTimingSensitive  Boolean   @default(false)
  // Block 3.7 (D-WS9-066) — swappable-component tags. A step with a null
  // `componentKey` is BASE: it is always part of the recipe regardless of any
  // convenience swap. A tagged step belongs to one swappable component
  // (`componentKey` → an entry in the parent Dish's `componentRegistry`) on one
  // path: `pathKey` is 'scratch' (the from-scratch steps that become
  // unnecessary when the product is bought) or 'bought' (what the cook does with
  // the store-bought product). The effective recipe for a user = base steps +
  // the selected path's steps per component. NULLABLE — every existing/legacy
  // step is base, so the 1,125-meal catalog stays valid untouched. Nothing reads
  // these yet (migration only).
  componentKey       String?
  pathKey            String? // 'scratch' | 'bought' — enforced at application layer
  // WS7-8b BUG-003 Block 1 (D-WS7-171 scope: dish-owned steps only). Sidecar
  // step→ingredient reference links, DERIVED server-side at materialize time
  // from the dish's own DishIngredient rows. Each ref:
  //   { ingredientId, quantity, unit, charStart, charEnd }
  // where `quantity` is the step's authored literal at base servings (0.75 for
  // "¾ cup"), NOT the DishIngredient canonical total — so partial/split steps
  // render correctly when scaled. Forward-only: null on every legacy step and
  // on steps with no matchable amounts; render falls back to plain text.
  amountRefs         Json?

  @@index([ownerType, ownerId])
  @@map("recipe_instruction_steps")
}

model MealPlanTemplate {
  id                  String     @id @default(uuid())
  userId              String
  title               String
  description         String?
  // WS9 3f-4d (D-WS9-121) — short display name. null = render `title` as-is;
  // non-null = the ≤42-char name the UI shows while `title` STAYS canonical.
  // Mirrors MealPlanInstance.titleOverride. Resolved via resolveDisplayTitle.
  displayTitle        String?
  sourceType          SourceType @default(wizard)
  defaultDaysCount    Int        @default(5)
  tags                String[]   @default([])
  imageUrl            String?
  isArchived          Boolean    @default(false)
  isPublic            Boolean    @default(false)
  likeCount           Int        @default(0)
  saveCount           Int        @default(0)
  useCount            Int        @default(0)
  deletedPlanCount    Int        @default(0) // free tier conversion signal
  lastUsedAt          DateTime?
  isFeatured          Boolean    @default(false)
  featuredRank        Int?
  featuredStartDate   DateTime?
  featuredEndDate     DateTime?
  isHostingFeatured   Boolean    @default(false)
  hostingFeaturedRank Int?
  // WS9-2 2c (D-WS9-154) — hand-curated order for the Home "Featured plans" rail.
  // 1 = leftmost, null = out of the rail entirely. No default, no unique
  // constraint, no index: gaps are fine, ties fall through to createdAt desc,
  // and the pool is 72 rows.
  //
  // Why NOT featuredRank / hostingFeaturedRank: PRD S15.6.2 defines those as
  // manual sort WITHIN Featured and manual sort WITHIN Hosting & Events -- two
  // per-pool orderings. The rail is a single FLAT sequence spanning both badge
  // families plus unbadged rows, which neither can express (a row that is both
  // Featured and Hosting has no defined winner between two per-pool ranks).
  // Those two columns are inert today and STAY inert; this is not a duplicate
  // of either. See the 2c Phase 0 audit S3.
  railPosition        Int?
  occasionType        String?
  // WS7-3 A1: Top Rated score cache (PRD §15.6.4). Nullable — compute-on-write
  // helper + scoring formula land in WS7-3 A2; both stay null until then.
  topRatedScore          Float?
  topRatedScoreUpdatedAt DateTime?
  optimizationNotes      Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  user      User                   @relation(fields: [userId], references: [id])
  instances MealPlanInstance[]
  items     MealPlanTemplateItem[]

  @@map("meal_plan_templates")
}

model MealPlanInstance {
  id                 String     @id @default(uuid())
  userId             String
  mealPlanTemplateId String?
  titleOverride      String?
  startDate          DateTime?
  endDate            DateTime?
  status             PlanStatus @default(draft)
  // WS7-6 (E) Block 1 REWORK — "this week" is computed under Model 2:
  // among rows where now ∈ [startDate, endDate], the one with the
  // greatest activatedAt wins (null loses to set; among nulls, newest
  // createdAt wins). See lib/planDates.ts resolveThisWeekPlan for the
  // single canonical resolver; the wire shape still ships
  // isActiveThisWeek: boolean (Block 1 decision #2) so mobile parsers
  // do not need to change. Plans may freely share date ranges; no
  // EXCLUDE constraint. Activation seams stamp activatedAt = now.
  // Auto-roll: a sole covering plan with null activatedAt still wins.
  activatedAt        DateTime?
  lastCooked         DateTime?
  timesCooked        Int        @default(0)
  notes              String?
  prepStatus         PrepStatus @default(not_prepped)
  // WS7-8a B3 (D-WS7-153) — manual-override pin for the prep-status rollup.
  // false = prepStatus is auto-derived from per-meal PrepStepCompletion state
  // on read; true = a user PATCH /plans/:id { prepStatus } pinned an explicit
  // value (incl. end-of-session "Done" → prepped) that wins over the derived
  // value until cleared (un-mark / reset flips this back to false). Kept as an
  // explicit boolean rather than overloading prepStatus so derived vs pinned is
  // unambiguous and the rollup can resume driving prepStatus when unpinned.
  prepStatusIsManual Boolean    @default(false)
  // optimizationNotes now holds ONLY the PRD §8.3.4 prep-notes array
  // [{type,text}] on real plans. It used to double-duty as the wizard draft
  // JSON blob too; D-WS9-034 (Plan-Gen Arc Block 2 Phase 1A) untangled that
  // onto the dedicated wizardDraftPayload column below. coerceOptimizationNotes
  // (plans.ts) is retained to heal legacy rows that still carry a blob here.
  optimizationNotes  Json?
  // D-WS9-034 — the wizard draft's expanded-plan JSON, written by
  // persistWizardDraft (POST /wizard/expand) and read back by the finalize /
  // activate / resume paths. Cleared to DbNull when the draft is consumed
  // (activate/save) or superseded/dismissed. Null on every non-draft row.
  wizardDraftPayload Json?
  compostedAt        DateTime?
  // WS9 3d (D-WS9-013, Part 2d) — the moment this row became a REAL, committed
  // (non-draft) plan. Set on every commit path: at create for plans born
  // committed (POST /plans, use-template), and on the draft→plan flip for
  // wizard save/activate. Deliberately NOT `createdAt` — a wizard draft's
  // createdAt is stamped at POST /wizard/expand (possibly weeks before commit),
  // so comparing dietaryUpdatedAt > createdAt would fire the staleness note
  // spuriously the instant an old draft is saved. NULL on hidden wizard drafts
  // (not yet committed) and on pre-migration rows (backfill posture: null ⇒
  // "never stale" → note silent, cheaper than a false allergy warning).
  committedAt        DateTime?
  isArchived         Boolean    @default(false)
  // WS7-5a — Branch B wizard draft discriminator. true on rows written by
  // POST /api/wizard/expand; flipped to false on "Save and use" activation
  // (WS7-5b). my_plans + home + this-week surfaces filter this true.
  // Distinct from status=draft (the schema default + use-template writes
  // would otherwise leak the existing active-plan flow into the hidden set).
  isWizardDraft      Boolean    @default(false)
  // Block 1 (BUG-030) — content-derived idempotency key (SHA-256 hex of the
  // plan title + sorted meal titles; see lib/wizardContentHash.ts). Written on
  // wizard-draft create and preserved when the row flips to a real plan on
  // activate/save, so re-expanding OR re-activating the same candidate reuses
  // the existing draft/plan instead of minting a duplicate. Nullable: legacy
  // rows and non-wizard plans carry null and never match a lookup.
  wizardContentHash  String?
  breakfastOverrides String?    // null = inherit from UserPreferences.breakfastDefaults; non-null = per-plan override
  lunchOverrides     String?    // null = inherit from UserPreferences.lunchDefaults; non-null = per-plan override
  // WS6 6c-4 / WS7 sync: monotonically increases on plan-content mutations.
  // GroceryList compares against lastGeneratedFromPlanRevisionId to detect drift.
  revisionId         Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user               User              @relation(fields: [userId], references: [id])
  template           MealPlanTemplate? @relation(fields: [mealPlanTemplateId], references: [id])
  items              MealPlanItem[]
  groceryLists       GroceryList[]
  prepWeekStructure  PrepWeekStructure?
  prepStepCompletions PrepStepCompletion[]

  @@index([userId, startDate, endDate])
  // Block 1 (BUG-030) — idempotency lookup: unconsumed drafts and materialized
  // plans are matched by (userId, wizardContentHash).
  @@index([userId, wizardContentHash])
  @@map("meal_plan_instances")
}

model MealPlanItem {
  id                  String    @id @default(uuid())
  mealPlanInstanceId  String
  mealId              String
  positionIndex       Int       @default(0)
  assignedDayOfWeek   String?
  assignedDate        DateTime?
  servingsOverride    Int?
  ingredientOverrides Json? // IngredientOverride[]
  recipeOverrideJson  Json? // RecipeOverride per PRD §8.4.3 — plan-instance recipe override; null = use Meal's default recipe
  // Block 3.7 (D-WS7-215) — PER-PLAN component selection ("this week only"): a
  // NON-DESTRUCTIVE map { [dishId]: { [componentKey]: 'scratch' | 'bought' } }
  // scoped to this plan instance. OVERRIDES the per-user Dish.componentSelections
  // for this plan; absent = fall back to the user/dish default. NULLABLE +
  // reversible. Nothing reads it yet (migration only).
  componentSelections Json?
  isBreakfast         Boolean   @default(false)
  isLunch             Boolean   @default(false)
  isDinner            Boolean   @default(true)
  lastCooked          DateTime?
  timesCooked         Int       @default(0)
  notes               String?

  planInstance MealPlanInstance @relation(fields: [mealPlanInstanceId], references: [id], onDelete: Cascade)
  meal         Meal             @relation(fields: [mealId], references: [id])

  @@map("meal_plan_items")
}

model MealPlanTemplateItem {
  id                 String  @id @default(uuid())
  mealPlanTemplateId String
  mealId             String
  positionIndex      Int     @default(0)
  assignedDayOfWeek  String?
  isBreakfast        Boolean @default(false)
  isLunch            Boolean @default(false)
  isDinner           Boolean @default(true)

  template MealPlanTemplate @relation(fields: [mealPlanTemplateId], references: [id], onDelete: Cascade)
  meal     Meal             @relation(fields: [mealId], references: [id])

  @@index([mealPlanTemplateId])
  @@map("meal_plan_template_items")
}

model GroceryList {
  id                              String            @id @default(uuid())
  userId                          String
  title                           String
  mealPlanInstanceId              String?
  sourceType                      String            @default("plan")
  status                          GroceryListStatus @default(draft)
  lastUsedAt                      DateTime?
  // WS6 6c-4 / WS7 sync: drift detection against MealPlanInstance.revisionId.
  lastGeneratedFromPlanRevisionId Int?
  lastGeneratedAt                 DateTime?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id])
  planInstance MealPlanInstance? @relation(fields: [mealPlanInstanceId], references: [id])
  items        GroceryListItem[]

  @@map("grocery_lists")
}

model GroceryListItem {
  id                 String       @id @default(uuid())
  groceryListId      String
  ingredientId       String?
  displayName        String
  quantity           Float        @default(1)
  unit               String       @default("")
  storeSection       StoreSection @default(extras)
  isChecked          Boolean      @default(false)
  isOptional         Boolean      @default(false)
  wasAiInferred      Boolean      @default(false)
  isAmbiguous        Boolean      @default(false)
  // WS6 6c-4: source-tracked staple flags. Both can be true on one item.
  isUniversalStaple  Boolean      @default(false)
  isUserPantryStaple Boolean      @default(false)
  isRecurringItem    Boolean      @default(false)
  // WS6 6c-4 / WS7 sync: AI-surfaced ambiguity options + user resolution.
  ambiguityOptions   String[]     @default([])
  userResolvedTo     String?
  // WS7-7-A Block 1: ownership discriminator for delta-reconcile. Generation
  // rows are plan-derived (false); rows added via POST /:id/items are user
  // "Extras" (true) and are NEVER touched by reconcile. Distinct from
  // provenance (GroceryListItemSource) — ownership vs source.
  isUserAdded        Boolean      @default(false)
  // WS7-7-A Block 2 — §12.7 per-list staple opt-in ("buying this week").
  // Distinct from isUniversalStaple (the generation-stamped classification,
  // immutable via the item PATCH route): a universal-staple item renders
  // greyed/unselected until the user taps to set this true on THIS list.
  stapleOptedIn      Boolean      @default(false)
  // WS7-7-A Block 2 — §12.9 soft-delete with restore window (D-WS6-082:
  // restore must reuse the same row id). Soft-deleted rows are excluded from
  // GET list/detail reads but keep their GroceryListItemSource rows intact
  // (cascade fires on hard delete only) so restore re-finds provenance.
  deletedAt          DateTime?
  notes              String?
  // WS7-8b B2 commit 3 — the buyable pack, persisted as DATA (not baked into
  // displayName) so the client composes the two-part line
  // "{purchaseDisplay} {name} ({needGlyph} {unit})" at render. The pack is
  // DERIVED (reconcile regenerates it from fresh conversion data); the need
  // (quantity/unit) is AUTHORED and edited via quantity. Nothing formatted is
  // ever persisted — quantityAmount stays the raw editable value.
  purchaseUnit       String?
  purchaseQuantity   Float?
  purchaseDisplay    String?

  groceryList GroceryList             @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  ingredient  Ingredient?             @relation(fields: [ingredientId], references: [id])
  sources     GroceryListItemSource[]

  @@map("grocery_list_items")
}

// WS7-7-A Block 1 — per-row plan provenance for delta-scoped reconcile.
// One row per (groceryListItem, mealId, dishId) contributing source. A
// consolidated line aggregating an ingredient from multiple meals/dishes
// gets one source row per contributing (meal, dish) pair, so Block 4 can
// carry a row forward when ALL its source meals are unchanged and
// re-resolve it when ANY source meal changed. Plan-derived rows only;
// user-added + synthetic recurring rows have zero source rows (replaces the
// dropped singular sourceMealId/sourceDishId columns, which were never read
// and could not represent multi-source lines).
model GroceryListItemSource {
  id                String          @id @default(uuid())
  groceryListItemId String
  mealId            String
  dishId            String
  // WS7-7-A Block 5 (D-WS7-137) — per-source change-signature. Lets reconcile
  // detect an INTRA-meal edit (servings or ingredient add/remove/qty/unit/name)
  // on a meal that stays in the plan: same mealId, but a changed contribution.
  // `servings` = effectiveServings (servingsOverride ?? dish.servingsDefault)
  // used at generation; `ingredientSignature` = stable hash of this source
  // dish's EFFECTIVE base ingredient set (canonical|quantity|unit, override-
  // applied). Nullable so pre-existing rows backfill to null and re-resolve
  // once on first post-deploy reconcile (D1: correctness over saving one pass).
  servings            Int?
  ingredientSignature String?

  item GroceryListItem @relation(fields: [groceryListItemId], references: [id], onDelete: Cascade)

  @@index([groceryListItemId])
  @@index([mealId])
  @@map("grocery_list_item_sources")
}

// WS6 6d-2 — Prep the Week structure cache (PRD §13.4 / §13.4.6).
// Cached per (planId, planRevisionId) so subsequent screen entries return
// the same stable 4-phase structure required by PRD §13.4.4/§13.4.5
// (phase + step state persistence). Mirrors GroceryList drift detection:
// when MealPlanInstance.revisionId moves past lastGeneratedFromPlanRevisionId,
// the next request regenerates and updates this row.
model PrepWeekStructure {
  id                              String   @id @default(uuid())
  planId                          String   @unique
  structureJson                   Json
  lastGeneratedFromPlanRevisionId Int
  lastGeneratedAt                 DateTime @default(now())
  promptVersion                   Int
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  plan MealPlanInstance @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("prep_week_structures")
}

// WS7-8a B3 (D-WS7-153) — per-step "marked done" persistence for Prep the Week
// (PRD §13.4.5). One row per checked step; the row's presence IS the checked
// state (uncheck = delete the row). Keyed by a STABLE stepKey derived in code
// (`${phase}#${ingredientId}` for normal steps, `${phase}#dish#${dishId}` for
// per-dish grouped steps — seasonings_dry blends (BUG-016 / D-WS7-187) and
// sauces_marinades dishes) — NOT the positional step number, which is unstable
// across a structureJson regenerate. State deliberately lives OUTSIDE
// PrepWeekStructure.structureJson (which is overwritten wholesale on regenerate);
// the regenerate path prunes rows whose stepKey is absent from the freshly
// assembled step set. Per-meal prepped state + the plan-level prepStatus rollup
// are DERIVED from these rows joined against contributesToMealIds — not stored.
// Chosen over a JSON column for queryability, row-per-check concurrency safety,
// and declarative cascade lifecycle.
model PrepStepCompletion {
  id        String   @id @default(uuid())
  planId    String
  stepKey   String
  checkedAt DateTime @default(now())

  plan MealPlanInstance @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, stepKey])
  @@index([planId])
  @@map("prep_step_completions")
}

model Retailer {
  id                         String          @id @default(uuid())
  name                       String
  slug                       String          @unique
  integrationType            IntegrationType @default(api)
  isEnabled                  Boolean         @default(true)
  logoUrl                    String?
  supportsAuth               Boolean         @default(true)
  supportsCartAdd            Boolean         @default(true)
  supportsAvailabilityLookup Boolean         @default(false)

  connections   RetailerConnection[]
  orderSessions OrderSession[]

  @@map("retailers")
}

model RetailerConnection {
  id            String    @id @default(uuid())
  userId        String
  retailerId    String
  status        String    @default("connected")
  authReference String? // encrypted token reference — never store raw credentials
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  retailer Retailer @relation(fields: [retailerId], references: [id])

  @@unique([userId, retailerId])
  @@map("retailer_connections")
}

model OrderSession {
  id            String   @id @default(uuid())
  userId        String
  retailerId    String
  groceryListId String
  status        String   @default("pending")
  resultMessage String?
  cartUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  retailer Retailer @relation(fields: [retailerId], references: [id])

  @@map("order_sessions")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  planCode             SubscriptionPlan   @default(free)
  status               SubscriptionStatus @default(trialing)
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  promoCodeId          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@map("subscriptions")
}

model PromoCode {
  id              String    @id @default(uuid())
  code            String    @unique
  discountType    String // 'percent' | 'fixed'
  discountValue   Float
  validFrom       DateTime
  validTo         DateTime?
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  isActive        Boolean   @default(true)

  subscriptions Subscription[]

  @@map("promo_codes")
}

model NotificationPreference {
  id                             String  @id @default(uuid())
  userId                         String  @unique
  prepRemindersEnabled           Boolean @default(false)
  cookRemindersEnabled           Boolean @default(false)
  groceryRemindersEnabled        Boolean @default(true)
  weeklyPlanningRemindersEnabled Boolean @default(true)
  preferredGroceryReminderDay    String? @default("saturday")
  preferredPrepReminderDay       String? @default("sunday")
  preferredTimeOfDay             String? @default("09:00")

  @@map("notification_preferences")
}

model UserActivity {
  id         String            @id @default(uuid())
  userId     String
  eventType  ActivityEventType
  entityId   String?
  entityType String?
  platform   String?
  metadata   Json?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("user_activities")
}

// ── WS6 AI orchestration (per kiwi_ws6_plan.md §3 6a-2) ──

model AIPrompt {
  id           String       @id @default(uuid())
  key          String       @unique
  description  String
  variables    String[]     @default([])
  defaultModel String
  defaultMode  AIPromptMode
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  versions AIPromptVersion[]

  @@map("ai_prompts")
}

model AIPromptVersion {
  id          String   @id @default(uuid())
  promptId    String
  version     Int
  body        String   @db.Text
  notes       String?
  createdById String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  prompt    AIPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PromptVersionCreator", fields: [createdById], references: [id])

  @@unique([promptId, version])
  @@index([promptId, isActive])
  @@map("ai_prompt_versions")
}

model SystemSetting {
  key          String   @id
  value        Json
  description  String
  defaultValue Json
  updatedById  String?
  updatedAt    DateTime @updatedAt

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id])

  @@map("system_settings")
}

model LLMCallLog {
  id              String       @id @default(uuid())
  promptKey       String
  promptVersion   Int?
  model           String
  mode            AIPromptMode
  userId          String?
  latencyMs       Int
  inputTokens     Int
  outputTokens    Int
  // Plan-Gen Arc · Block 3 (D-WS9-042) — prompt-cache telemetry. Nullable so
  // existing rows stay valid and non-cached calls record nothing. `inputTokens`
  // is the UNCACHED remainder; total prompt = inputTokens + these two.
  cacheReadInputTokens     Int?
  cacheCreationInputTokens Int?
  costEstimateUsd Decimal      @db.Decimal(10, 6)
  retryCount      Int          @default(0)
  success         Boolean
  failureReason   String?
  createdAt       DateTime     @default(now())

  user User? @relation("LLMCallUser", fields: [userId], references: [id])

  @@index([createdAt])
  @@index([promptKey, createdAt])
  @@index([userId, createdAt])
  @@map("llm_call_logs")
}
