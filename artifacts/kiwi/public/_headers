# SEC-3 (SEC-1 #9) - Netlify response headers for app.kitchenwizard.ai.
# expo export copies public/ into dist/, so this ships in kiwi-web-dist.zip.
#
# CSP origins, each one seen in the app (SEC-3 report has the list):
#   script  accounts.google.com/gsi/client (lib/oauth/googleWeb.ts)
#           appleid.cdn-apple.com (lib/oauth/appleWeb.ts)
#           challenges.cloudflare.com (components/TurnstileGate.tsx)
#   style   accounts.google.com/gsi/style (GIS adds it); 'unsafe-inline' is
#           react-native-web, which writes inline style attributes and <style>
#   connect the production API (lib/api/base.ts via export-web.ps1), GIS
#   frame   the GIS button, the Turnstile widget, Apple's sign-in
#   img     meal photos on storage.googleapis.com, picked photos (blob:/data:)
#   font    the fonts are bundled (dist/assets), no font host
# Stripe checkout/portal and Instacart are top-level navigations, which CSP
# does not govern.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://appleid.cdn-apple.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://storage.googleapis.com https://appleid.cdn-apple.com; font-src 'self' data:; connect-src 'self' https://kiwi-api-166146829159.us-east4.run.app https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://challenges.cloudflare.com https://appleid.apple.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
