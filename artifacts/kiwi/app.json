{
  "expo": {
    "name": "Kiwi",
    "slug": "kiwi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1024.png",
    "scheme": "kiwi",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/76d74056-14ab-4840-b0ba-1caec7f51b59"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/images/splash-icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#3a5235"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kitchenwizard.kiwi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Kiwi to access your camera to import recipe images.",
        "NSPhotoLibraryUsageDescription": "Allow Kiwi to access your photos to import recipe images."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground-1024.png",
        "backgroundColor": "#3a5235"
      },
      "package": "com.kitchenwizard.kiwi"
    },
    "web": {
      "favicon": "./assets/images/favicon-64.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://kitchenwizard.ai"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kiwi to access your photos to import recipe images.",
          "cameraPermission": "Allow Kiwi to access your camera to import recipe images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "76d74056-14ab-4840-b0ba-1caec7f51b59"
      }
    }
  }
}
