{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "lib/api/__tests__/**/*",
    "contexts/__tests__/**/*",
    "components/__tests__/**/*",
    "components/preference-pickers/__tests__/**/*",
    "hooks/__tests__/**/*",
    "lib/home/__tests__/**/*",
    "lib/plans/__tests__/**/*",
    "lib/meals/__tests__/**/*",
    "lib/dishes/__tests__/**/*"
  ],
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
